#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#include "macropad.dtsi"

#define BASE 0
#define KP   1
#define FN   2
#define MOD  3
#define HALF 4
#define NAV  5
#define SYM  6


#define LEFT_HAND_KEYS     0 1 2 3 4 5 6 \
                           14 15 16 17 18 19 20 \
                           28 29 30 31 32 33 34 \
                           46 47 48 49 50 51 \
                           66 67 68 69 70

#define RIGHT_HAND_KEYS    7 8 9 10 11 12 13 \
                           21 22 23 24 25 26 27 \
                           39 40 41 42 43 44 45 \
                           60 61 62 63 64 65 \
                           77 78 79 80 81

#define THUMBS_LEFT 35 36 54 71 72 73

#define THUMBS_RIGHT 37 38 57 74 75 76

#define THUMBS THUMBS_LEFT THUMBS_RIGHT

// mac screenshot
#define _SCRNS &kp LG(LS(NUMBER_4))

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

    hm: homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS";
        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        // flavor = "tap-preferred";
        flavor = "balanced";
        bindings = <&kp>, <&kp>;
    };

    hml: home_row_mod_left {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS_LEFT";
        #binding-cells = <2>;

        flavor = "balanced";            // Or "tap-unless-interrupted"
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;               // Repeat the key if tapped twice
        require-prior-idle-ms = <125>;      // Prevents accidental mods during rolls

        bindings = <&kp>, <&kp>;

        hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMBS>;
        hold-trigger-on-release;        // Wait for the secondary key to release
    };

    hmr: home_row_mod_right {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS_RIGHT";
        #binding-cells = <2>;

        flavor = "balanced";
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <125>;

        bindings = <&kp>, <&kp>;

        hold-trigger-key-positions = <LEFT_HAND_KEYS THUMBS>;
        hold-trigger-on-release;
    };

    macros {
        macro_000: macro_000 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0>, <&kp KP_N0>, <&kp KP_N0>;
        };
    };

    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1        &kp N2          &kp N3          &kp N4          &kp N5 &tog KP                                                                                       &mo MOD  &kp N6       &kp N7        &kp N8          &kp N9          &kp N0          &kp MINUS
        &kp TAB   &kp Q         &kp W           &kp E           &kp R           &kp T  &tog HALF                                                                                     &none    &kp Y        &kp U         &kp I           &kp O           &kp P           &kp BSLH
        &kp ESC   &hml LGUI A   &hml LALT S     &hml LSHFT D    &hml LCTRL F    &kp G  &none                     &kp LCTRL         &kp LALT     &kp LGUI  &kp RCTRL                  &none    &kp H        &hmr RCTRL J  &hmr RSHFT K    &hmr RALT L     &hmr RGUI SEMI  &kp SQT
        &kp LSHFT &kp Z         &kp X           &kp C           &kp V           &kp B                                              &kp HOME     &kp PG_UP                                     &kp N        &kp M         &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT
        &none     &kp GRAVE     &kp CAPS        &kp LEFT        &kp RIGHT                          &lt NAV SPACE &lt KP DEL        &kp END      &kp PG_DN &lt FN ENTER &lt SYM BSPC                        &kp DOWN      &kp UP          &kp LBKT        &kp RBKT        &kp PRINTSCREEN
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &none     &none   &none          &none           &none  &trans                                                         &mo MOD  &none      &kp KP_NUM   &kp KP_EQUAL     &kp KP_DIVIDE &kp KP_MULTIPLY &none
        &kp TAB   &none     &none   &none          &none           &none  &none                                                          &none    &none      &kp KP_N7    &kp KP_N8        &kp KP_N9     &kp KP_MINUS    &none
        &kp ESC   &none     &none   &none          &none           &none  &none           &none   &none   &kp DEL &kp BSPC               &none    &kp MINUS  &kp KP_N4    &kp KP_N5        &kp KP_N6     &kp KP_PLUS     &none
        &kp LSHFT &none     &none   &kp LS(SPACE)  &kp LC(SPACE)   &none                          &none   &none                                   &none      &kp KP_N1    &kp KP_N2        &kp KP_N3     &kp KP_ENTER    &none
        &trans    &none     &none   &kp LC(PG_UP)  &kp LC(PG_DN)                 &kp BSPC &trans  &none   &none   &kp ENTER &kp KP_N0                        &macro_000   &kp COMMA        &kp KP_DOT    &none           &trans
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &trans &trans   &trans   &trans    &trans    &trans     &tog 1                                             &mo MOD       &trans    &trans   &trans    &trans    &trans    &trans
        &trans &kp EXCL &kp AT   &kp HASH  &kp DLLR  &kp PRCNT  &none                                              &none         &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &trans
        &trans &kp F1   &kp F2   &kp F3    &kp F4    &kp F5     &none        &trans &trans    &trans &trans        &none         &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &trans
        &trans &kp F11  &kp F12  &kp F13   &kp F14   &kp F15                        &trans    &trans                             &kp F16   &kp F17  &kp F18   &kp F19   &kp F20   &trans
        &trans &trans   &trans   &trans    &trans                     &trans &trans &trans    &trans &trans &trans                         &trans   &trans    &trans    &trans    &trans
      >;
    };


    mod {
      display-name = "MOD";
      bindings = <
        &none              &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                            &trans                 &none        &none        &none        &none &none &none
        &none              &none        &none        &none        &none        &none        &bootloader                                                                      &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock     &none        &none        &none        &none        &none        &none                   &none &none    &bt BT_CLR &none                          &stp STP_BAT           &none        &none        &none        &none &none &none
        &none              &none        &none        &none        &macro_ver   &none                                      &none    &none                                                            &none        &none        &none        &none &none &none
        &none              &none        &none        &none        &none                                       &none &none &none    &none      &bl BL_TOG &rgb_ug RGB_TOG                                         &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    half {
      display-name = "HALF";
      bindings = <
        &kp F1          &none      &none            &none      &none      &none      &none                                                                               &none     &none          &none          &none          &none          &none          &none
        &kp LC(LS(V))   &mm_q      &mm_w            &mm_e      &kp F2     &mm_t      &tog HALF                                                                           &none     &none          &none          &none          &none          &none          &none
        &kp ESC         &mm_a      &mm_s            &mm_d      &mm_f      &kp LC(L)  &none                    &kp HOME    &kp END     &kp LGUI    &kp RCTRL              &none     &none          &none          &none          &none          &none          &none
        &none           &mm_z      &kp LC(X)        &kp LC(C)  &kp LC(V)  &kp PSCRN                                       &kp LCTRL   &kp PG_UP                                    &none          &none          &none          &none          &none          &none
        &none           &kp GRAVE  &kp LA(LSHFT)    &mm_left   &mm_right                             &mm_del  &kp ENTER   &kp LSHIFT  &kp PG_DN   &kp ENTER   &kp KP_N0                           &none          &none          &none          &none          &none
      >;
    };

    nav {
      display-name = "NAV";
      bindings = <
        &none      &none           &none           &none       &none       &none   &tog 1                                                                             &mo 3  &none  &none       &none     &none     &none &none
        &none      &kp LA(F4)      &kp LC(W)       &none       &none       &none   &tog HALF                                                                          &none  &none  &none       &kp UP    &none     &none &none
        &none      &kp LGUI        &kp LALT        &kp LSHFT   &kp LCTRL   &none   &none                        &kp LCTRL &kp LALT    &kp LGUI  &kp RCTRL             &none  &none  &kp LEFT    &kp DOWN  &kp RIGHT &none &none
        &none      &kp LC(Z)       &kp LC(X)       &kp LC(C)   &kp LC(V)   &none                                          &kp HOME    &kp PG_UP                              &none  &none       &none     &none     &none &none
        &tog NAV   &none           &none           &none       &none                                    &trans  &kp DEL   &kp END     &kp PG_DN &kp ENTER &none                     &none       &none     &none     &none &none
      >;
    };

    symbol {
      display-name = "SYM";
      bindings = <
        &none   &none       &none       &none       &none       &none       &tog 1                                                                           &mo 3  &none  &none &none &none &none &none
        &none   &kp EXCL    &kp AT      &kp LBKT    &kp RBKT    &kp PIPE    &tog HALF                                                                        &none  &none  &none &none &none &none &none
        &none   &kp HASH    &kp DLLR    &kp LPAR    &kp RPAR    &kp GRAVE   &none                      &kp LCTRL &kp LALT    &kp LGUI  &kp RCTRL             &none  &none  &none &none &none &none &none
        &none   &kp PRCNT   &kp CARET   &kp LBRC    &kp RBRC    &kp TILDE                                        &kp HOME    &kp PG_UP                              &none  &none &none &none &none &none
        &none   &none       &none       &none       &none                                    &kp BSPC  &trans    &kp END     &kp PG_DN &kp ENTER &kp BSPC                  &none &none &none &none &none
      >;
    };


    symbol2 {
      display-name = "SYM2";
      bindings = <
        &none  &none       &none          &none              &none      &none       &tog 1                                                                         &mo 3          &none          &none       &none       &none       &none          &none
        &none  &kp GRAVE   &kp LESS_THAN  &kp GREATER_THAN   &kp MINUS  &kp PIPE    &tog HALF                                                                      &none          &kp CARET      &kp LBRC    &kp RBRC    &kp DLLR    &kp RIGHT      &none
        &none  &kp EXCL    &kp ASTRK      &kp FSLH           &kp EQUAL  &kp AMPS    &none                  &kp LCTRL &kp LALT  &kp LGUI    &kp RCTRL               &none          &kp HASH       &kp LPAR    &kp RPAR    &kp SEMI    &kp DQT        &none
        &none  &kp TILDE   &kp PLUS       &kp LBKT           &kp RBKT   &kp PRCNT                                    &kp HOME  &kp PG_UP                                          &kp AT         &kp COLON   &kp COMMA   &kp DOT     &kp SQT        &none
        &none  &none       &none          &none              &none                               &kp BSPC  &trans    &kp END   &kp PG_DN   &kp ENTER   &kp BSPC                                  &none       &none       &none       &none          &none
      >;
    };


    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
